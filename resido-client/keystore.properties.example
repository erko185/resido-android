# Copy to keystore.properties and fill in. build.sh generates the keystore
# automatically on first run if keystore/resido-release.jks does not exist.
# BACK UP keystore/resido-release.jks + this file — losing them permanently
# breaks auto-updates for every installed tablet (Android rejects updates
# signed with a different key).
storeFile=keystore/resido-release.jks
storePassword=CHANGE_ME
keyAlias=resido
keyPassword=CHANGE_ME
